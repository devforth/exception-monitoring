# Local development settings for `make run`. Copy to .env.local (gitignored) and adjust.
# In Docker, pass the same variables with -e or an env file.

# APP_NAME=Exception Monitoring   # shown in the sidebar, page titles and emails, and to coding
#                                 # agents; agents register MCP under it in lowercase with
#                                 # dashes ("Acme Errors" -> acme-errors)
# PORT=8000
# DATA_DIR=./data                 # the SQLite database; keep it on a volume in Docker

# Projects: id:name:public_key, comma-separated. The DSN of a project is
# http://<public_key>@localhost:8000/<id>. They are written to the database at
# every start with these values (name and key can only change here); more
# projects, and per-project retention, can be added on the Projects page.
PROJECTS=1:backend:backendkey0000000000000000000001,2:frontend:browserkey0000000000000000000002

# Web UI login (password: at least 12 characters). Without a password the UI is closed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-password-123

# REST API token (at least 32 characters, e.g. `openssl rand -hex 32`). Without it the
# REST API is closed. Coding agents do not use it: they sign in to MCP (/mcp) with OAuth
# through the admin login, or with a personal token; the MCP page of the UI has the commands.
API_TOKEN=0123456789abcdef0123456789abcdef

# LOG_LEVEL=debug                 # also logs rejected envelopes and every request
# ALLOWED_IPS=127.0.0.1           # restrict the UI, REST API and MCP to these addresses/networks
# TRUSTED_PROXIES=10.0.0.0/8      # reverse proxies whose X-Forwarded-For/-Proto are believed
#                                 # (client IP for ALLOWED_IPS and limits, https for cookies and DSNs)

# Ingest (the DSN endpoint SDKs send to).
# ALLOWED_ORIGINS=*               # browser origins allowed to send events (CORS), e.g.
#                                 # https://app.example.com,https://admin.example.com
# RATE_LIMIT_PER_MINUTE=1000      # envelopes per project per minute; 0 = no limit

# Notifications about new and regressed issues. Where they go (email addresses,
# Telegram chats, Slack webhooks) is set up in the UI on the Notifications page.
# PUBLIC_URL=http://localhost:8000   # where the server is reachable: links in messages, DSNs and the
#                                    # MCP address (https://errors.example.com in production; over
#                                    # plain HTTP agent tokens could be read on the way)
# NOTIFY_CHANNEL_TYPES=email,telegram,slack   # connection types that can be added; "none" for no notifications

# Encrypts Telegram tokens and Slack webhooks in the database (at least 32 characters,
# e.g. `openssl rand -hex 32`). Keep it out of the data directory. Required for Telegram and Slack.
# SECRET_KEY=

# Delivery is stored in the database and retried (2s, 10s, 30s, ... then hourly).
# Durations take days or Go units: 30d, 12h, 90m.
# NOTIFY_RETRY_FOR=1d                # retry this long, then mark the message failed
# NOTIFY_KEEP_SENT=1d                # delete delivered messages after this
# NOTIFY_KEEP_FAILED=30d             # delete failed messages after this

# Mail server for email connections and their confirmation codes. Any SMTP provider
# works (Mailtrap sandbox for testing, Mailgun, SES, ...). Port 465 uses TLS from the
# start; other ports use STARTTLS.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=errors@example.com

# Levels stored; others are dropped when they arrive (no notification either).
# A project can choose its own on the Projects page. "all", "none" or a list.
# RECORD_EVENT_LEVELS=error,fatal    # errors and messages: fatal, error, warning, info, debug
# RECORD_LOG_LEVELS=all              # logs: fatal, error, warn, info, debug, trace

# Retention: old data is deleted every 10 minutes. 0 turns a limit off.
# Issues keep their latest event until they have not happened for RETENTION_ISSUES.
# RETENTION_EVENTS=30d               # delete events received longer ago than this
# RETENTION_LOGS=14d                 # delete logs older than this (usually far more of them)
# RETENTION_EVENTS_PER_ISSUE=100     # keep only the newest events of each issue (the count stays)
# RETENTION_LOGS_PER_MESSAGE=50     # keep the newest logs of a message logged over and over (other numbers/IDs count as the same)
# RETENTION_ISSUES=365d             # delete issues (with their events) not seen for this long
# MAX_DATABASE_SIZE=2GB              # above it, delete the oldest events and logs down to 90%
